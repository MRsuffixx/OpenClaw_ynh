{
  "gateway": {
    "port": __PORT__,
    "bind": "127.0.0.1",
    "auth": {
      "headerUser": "X-Remote-User",
      "headerEmail": "X-Remote-Email",
      "token": "__GATEWAY_AUTH_TOKEN__"
    }
  },
  "update": {
    "channel": "__UPDATE_CHANNEL__",
    "checkOnStart": true,
    "auto": {
      "enabled": __AUTO_UPDATE__
    }
  },
  "server": {
    "publicUrl": "https://__DOMAIN____PATH__"
  }
}