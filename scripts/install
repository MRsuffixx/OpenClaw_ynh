#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# RETRIEVE SETTINGS
#=================================================

openclaw_version="${openclaw_version:-latest}"
update_channel="${update_channel:-stable}"
gateway_auth_token="${gateway_auth_token:-}"
auto_update="${auto_update:-0}"

if [[ -z "$gateway_auth_token" ]]; then
    gateway_auth_token="$(openssl rand -hex 32 2>/dev/null || dd if=/dev/urandom bs=1 count=32 2>/dev/null | xxd -p)"
fi

#=================================================
# CREATE LOG DIRECTORY
#=================================================

mkdir -p "/var/log/$app"
chown "$app:$app" "/var/log/$app"

#=================================================
# RUN INSTALL-CLI.SH
#=================================================

ynh_script_progression "Installing OpenClaw..."

download_verified \
    "$INSTALL_CLI_URL" \
    "/tmp/openclaw_install_cli_$$.sh" \
    "$INSTALL_CLI_SHA256"
chmod +x "/tmp/openclaw_install_cli_$$.sh"

run_as_openclaw bash "/tmp/openclaw_install_cli_$$.sh" \
    --no-onboard \
    --install-method npm \
    --version "$openclaw_version" \
    --prefix "/home/$app/.openclaw" \
    --set-npm-prefix \
    --json 2>&1 | tee -a "/var/log/$app/install.log"

rm -f "/tmp/openclaw_install_cli_$$.sh"

#=================================================
# WRITE OPENCLAW.JSON
#=================================================

ynh_script_progression "Configuring OpenClaw gateway..."

export OPENCLAW_BIN="$(openclaw_bin)"
export OPENCLAW_STATE_DIR="$(openclaw_state_dir)"

ynh_config_add --template="openclaw.json" --destination="$data_dir/openclaw.json"

#=================================================
# CONFIGURE PATH DROP-IN
#=================================================

cat > "/etc/profile.d/openclaw_${app}.sh" << EOF
export PATH="/home/$app/.openclaw/bin:\$PATH"
EOF
chmod +x "/etc/profile.d/openclaw_${app}.sh"

#=================================================
# INSTALL SYSTEMD UNIT
#=================================================

ynh_config_add_systemd

#=================================================
# ENABLE LINGERING
#=================================================

loginctl enable-linger "$app" 2>/dev/null || true

#=================================================
# CONFIGURE NGINX
#=================================================

ynh_config_add_nginx

#=================================================
# SET PERMISSIONS
#=================================================

yunohost app addaccess --users all "$app"

#=================================================
# REGISTER SERVICE
#=================================================

yunohost service add "$app" \
    --description="OpenClaw AI Gateway" \
    --log="/var/log/$app/$app.log" \
    --test_status="curl -fsS http://127.0.0.1:${port}/readyz"

#=================================================
# CONFIGURE FAIL2BAN
#=================================================

ynh_config_add_fail2ban --logpath="/var/log/$app/error.log" \
    --failregex=".*\[openclaw\].*auth.*failed.*from <HOST>.*|.*\[openclaw\].*invalid token.*from <HOST>.*|.*\[openclaw\].*unauthorized.*<HOST>.*"

#=================================================
# START SERVICE
#=================================================

ynh_script_progression "Starting OpenClaw gateway..."

ynh_systemctl --service="$app" --action="start"

wait_for_gateway "$port"

#=================================================
# POST-INSTALL DOCTOR
#=================================================

ynh_script_progression "Running post-install health check..."

run_as_openclaw "$OPENCLAW_BIN" doctor --non-interactive 2>&1 | tee -a "/var/log/$app/install.log"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Installation of $app completed"